VITE_API_BASE_URL=http://localhost:8000
# Production Vercel build: set this in the Vercel project env to the public Docker API URL.
# Vite bakes the value in at build time. A Vercel page cannot call localhost:8000.
# VITE_API_BASE_URL=https://your-api.example.com
# Set true to drive the UI from src/fixtures without the API
# VITE_USE_FIXTURES=true

